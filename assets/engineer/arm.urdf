  <!-- 由 26 的 arm2_link 网格与 27 的 link_3 网格对齐后转换相机外参：
       T_link3_arm2 约为 xyz=(0, 0.01725, 0), rpy=(-pi/2, 0, 0)。
       两代机构及实际安装仍可能不同，此外参须对 27 实物标定验证。
       RealSense 发布 camera_link -> sensor/optical 内部变换。 -->
  <link name="camera_Link" />
  <joint name="camera_Joint" type="fixed">
    <parent link="link_3" />
    <child link="camera_Link" />
    <origin xyz="0.169866 0.07715 0.0205"
            rpy="0 0 0" />
  </joint>
  <link name="camera_link" />
  <joint name="intel_fake_joint" type="fixed">
    <parent link="camera_Link" />
    <child link="camera_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
