Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    # 当前机器人来自 robot_description 和 TF
    - Class: rviz_default_plugins/RobotModel
      Name: Current Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    # 只订阅预览轨迹，没有 Plan/Execute 按钮
    - Class: moveit_rviz_plugin/Trajectory
      Name: Validated Trajectory
      Enabled: true
      Robot Description: robot_description
      Color Enabled: true
      Robot Color: 255; 160; 0
      Trajectory Topic: /arm_planning/display_planned_path
      Loop Animation: false
      State Display Time: 0.05 s
    - Class: moveit_rviz_plugin/PlanningScene
      Name: Planning Scene
      Enabled: true
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Robot:
        Robot Visual Enabled: false
        Robot Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: base_link
Window Geometry:
  Width: 1280
  Height: 800
