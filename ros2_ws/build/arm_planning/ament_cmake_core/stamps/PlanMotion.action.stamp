# Joint order is link_1_joint ... link_6_joint; angles are radians.
# Pose targets refer to link_6, not a calibrated tool TCP.
uint8 JOINT=0
uint8 POSE=1
uint8 target_type
float64[6] joint_positions
geometry_msgs/PoseStamped target_pose
# execute=false only plans and publishes the RViz preview.
bool execute
# Zero selects the offline defaults (0.2, 0.2, 5 seconds).
float64 velocity_scaling
float64 acceleration_scaling
float64 planning_time
---
bool success
int32 error_code
string message
moveit_msgs/RobotTrajectory trajectory
float64[6] selected_joint_positions
float64 planning_time
float64 joint_path_length
uint32 validation_samples
uint32 ik_candidates
---
string stage
string detail
